# Local development only: copy to .env.local (never committed).
# The firebaseConfig object from Firebase console → Project settings → Your apps → Web, as one line of JSON.
VITE_FIREBASE_CONFIG={"apiKey":"...","authDomain":"...","projectId":"...","storageBucket":"...","messagingSenderId":"...","appId":"..."}
# App Check: the reCAPTCHA v3 site key registered in Firebase console → App Check.
# In `npm run dev` the app uses an App Check debug token instead: register the token it prints in the console.
VITE_RECAPTCHA_SITE_KEY=
# App Check provider registered in the Firebase console: enterprise (reCAPTCHA Enterprise, default) or v3 (classic).
VITE_APPCHECK_PROVIDER=enterprise
